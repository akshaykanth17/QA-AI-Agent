# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use (gpt-4o-mini is fast and cost-effective)
OPENAI_MODEL=gpt-4o-mini

# ── Browser Automation Safety ────────────────────────────────────────────────
# Comma-separated list of allowed target domains/hosts.
# localhost and 127.0.0.1 are always allowed.
# Example: ALLOWED_DOMAINS=localhost,127.0.0.1,staging.myapp.example.com
ALLOWED_DOMAINS=localhost,127.0.0.1

# Port for the local demo login app (default: 5000)
DEMO_PORT=5000

# Set to false ONLY in controlled dev environments — never in production.
SAFE_MODE=true

# ── Project ──────────────────────────────────────────────────────────────────
PROJECT_NAME=AI-Assisted Software Testing Agent

